class Solution {
    public int secondLargestElement(int[] nums) {
        int largest = -1;
        int secondLargest = -1;

        for (int num : nums) {
            if (num > largest) {
                secondLargest = largest;
                largest = num;
            } else if (num < largest && num > secondLargest) {
                secondLargest = num;
            }
        }

        return secondLargest;
    }
}
