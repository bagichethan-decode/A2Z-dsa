class Solution {
    public int[] quickSort(int[] nums) {
        sort(nums, 0, nums.length - 1);
        return nums;
    }

    void sort(int[] a, int l, int r) {
        if (l >= r) return;
        int p = a[r], i = l;
        for (int j = l; j < r; j++) {
            if (a[j] < p) swap(a, i++, j);
        }
        swap(a, i, r);
        sort(a, l, i - 1);
        sort(a, i + 1, r);
    }

    void swap(int[] a, int i, int j) {
        int t = a[i]; a[i] = a[j]; a[j] = t;
    }
}
